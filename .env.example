# ─── GITHUB ────────────────────────────────────────────────────────────────────
GITHUB_USERNAME=Muyideen-js
GITHUB_PASSWORD=your_github_password

# Only needed if you use an Authenticator app for 2FA (not SMS)
GITHUB_OTP_SECRET=

# ─── TELEGRAM ──────────────────────────────────────────────────────────────────
# 1. Message @BotFather → /newbot → copy token
# 2. Start your bot, visit: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat": { "id": <this number> }
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321

# ─── BOT BEHAVIOUR ─────────────────────────────────────────────────────────────
# Hours to wait before cancelling unanswered application
ACCEPTANCE_TIMEOUT_HOURS=24

# How often to run a full cycle (seconds) — 1800 = 30 min
POLL_INTERVAL_SECONDS=1800

# Max applications open at once across both platforms
MAX_ACTIVE_APPLICATIONS=3

# Show browser window (false) or run hidden (true)
# Use false when debugging, true when running normally
HEADLESS=true

# ─── DASHBOARD ─────────────────────────────────────────────────────────────────
# Your Render URL after deploying (leave blank until deployed)
DASHBOARD_URL=https://issuebot-dashboard.onrender.com

# Must match SYNC_SECRET set on Render
SYNC_SECRET=your-sync-secret-here

# Password to access dashboard locally (http://localhost:5000)
DASHBOARD_PASSWORD=issuebot2024

# Any random string — keeps sessions secure
DASHBOARD_SECRET_KEY=change-this-to-any-random-string
