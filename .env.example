# GitHub OAuth App credentials (for web dashboard sign-in)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Default Bot GitHub Credentials
GITHUB_USERNAME=your_github_username
GITHUB_PASSWORD=your_github_password
GITHUB_OTP_SECRET=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot Rules
ACCEPTANCE_TIMEOUT_HOURS=24
POLL_INTERVAL_SECONDS=1800
MAX_ACTIVE_APPLICATIONS=3
HEADLESS=true

# Dashboard Security
DASHBOARD_URL=https://issuebot.onrender.com
SYNC_SECRET=sync-secret-123
DASHBOARD_PASSWORD=issuebot2024
DASHBOARD_SECRET_KEY=random-secret-key
