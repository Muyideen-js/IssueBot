# Portal runtime
APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=sqlite:///issuebot.db
WORKER_TICK_SECONDS=30

# Vercel scheduler (copy both signing keys from the Upstash QStash console)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
SCAN_BATCH_SIZE=3
SCAN_TIME_BUDGET_SECONDS=220

# Initial administrator (created automatically when the service starts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Generate a credential encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
