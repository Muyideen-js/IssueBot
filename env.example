# ─── GITHUB CREDENTIALS ────────────────────────────────────────────────────────
GITHUB_USERNAME=Muyideen-js
GITHUB_PASSWORD=your_github_password_here

# Optional — only needed if you have 2FA enabled via Authenticator app
# Get the raw TOTP secret from GitHub Settings → Password and authentication → 2FA setup
# It looks like: JBSWY3DPEHPK3PXP
GITHUB_OTP_SECRET=

# ─── TELEGRAM ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── BOT BEHAVIOUR ─────────────────────────────────────────────────────────────
# Hours to wait before cancelling an unanswered application
ACCEPTANCE_TIMEOUT_HOURS=24

# How often to run a full cycle (seconds) — 1800 = 30 minutes
POLL_INTERVAL_SECONDS=1800

# Max applications open at once across both platforms
MAX_ACTIVE_APPLICATIONS=3

# Run browser visibly (false) or in background (true)
# Set to false when debugging selector issues
HEADLESS=true
